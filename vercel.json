{
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    }
  },
  "build": {
    "env": {
      "VITE_API_URL": "https://openconstructionerp-production.up.railway.app/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://openconstructionerp-production.up.railway.app/api/:path*"
    }
  ]
}
