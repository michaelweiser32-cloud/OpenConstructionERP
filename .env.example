# OpenEstimate Configuration
# Copy to .env and adjust values

# ── App ──────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# ── Database (required) ─────────────────────────────────────────
# Provider strings (Neon, Render…) can be pasted verbatim, including
# ?sslmode=require&channel_binding=require — they are normalised for
# asyncpg / psycopg2 automatically. DATABASE_SYNC_URL is derived from
# DATABASE_URL when omitted.
DATABASE_URL=postgresql+asyncpg://oe:oe@localhost:5432/openestimate
DATABASE_SYNC_URL=postgresql://oe:oe@localhost:5432/openestimate

# ── Redis (optional — falls back to in-memory) ──────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage ─────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=openestimate

# ── Auth ────────────────────────────────────────────────────────
# Placeholder only — rejected at startup outside APP_ENV=development.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# Admin login created/updated on every boot (min 12 chars on deploys)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Public sign-up / first-user-becomes-admin (auto: on in development only)
# ALLOW_SELF_REGISTRATION=false
# ALLOW_FIRST_USER_ADMIN=false
# Optional Host-header allowlist, e.g. myapp.onrender.com,*.example.com
# ALLOWED_HOSTS=*
# CORS regex for extra origins; "none" disables (default outside dev)
# CORS_ORIGIN_REGEX=none

# ── Demo accounts ───────────────────────────────────────────────
# DISABLE_DEMO_ACCOUNTS=1
# SEED_DEMO=false
# Required (>= 12 chars) when demo accounts are enabled outside development:
# DEMO_ADMIN_PASSWORD=
# DEMO_ESTIMATOR_PASSWORD=
# DEMO_MANAGER_PASSWORD=

# ── Rate Limiting (requests per minute) ─────────────────────────
# API_RATE_LIMIT=100
# LOGIN_RATE_LIMIT=10
# AI_RATE_LIMIT=10

# ── AI (optional — features degrade gracefully) ────────────────
# QDRANT_URL=http://localhost:6333
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
